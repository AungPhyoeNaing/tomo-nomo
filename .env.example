# Optional: point a static frontend deployment at a separate Nomo backend.
# Leave unset when the Node server serves both the frontend and Socket.IO.
# VITE_NOMO_SERVER_URL=https://your-nomo-server.example.com
# Server-only Gemini key. On Vercel set this in Project Settings > Environment Variables.
# Never use a VITE_ prefix for this secret.
GEMINI_API_KEY=
# Optional per-instance safety limits (not shared across Vercel instances).
# Five initial readings plus up to one repair/retry each. Set lower if your
# Google project's active model quota is lower; this is not quota discovery.
TOMO_AI_REQUESTS_PER_MINUTE=10
TOMO_AI_REQUESTS_PER_DAY=100
# Maximum simultaneous distinct readings per instance. Identical requests share work.
TOMO_AI_MAX_CONCURRENT=5
